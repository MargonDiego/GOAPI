# =============================================
# Go API — Variables de Entorno (template)
# =============================================
# Copiar este archivo a .env y completar los valores.
# NUNCA commitear .env con secretos reales.

# Entorno de ejecución: "development" | "production"
APP_ENV="development"

# Puerto HTTP del servidor
PORT="8080"

# [CRÍTICO] Clave HMAC-SHA256 para firmar JWTs.
# Generar con: openssl rand -base64 64
JWT_SECRET="your-64-char-jwt-secret-here"

# [CRÍTICO] DSN de PostgreSQL para la aplicación (usuario con permisos DML).
DB_DSN="postgresql://user:pass@localhost:5432/dbname?sslmode=disable"

# [CRÍTICO] DSN para golang-migrate (usuario con permisos DDL).
# Puede ser el mismo que DB_DSN si el usuario tiene ambos permisos.
MIGRATION_DSN="postgresql://postgres:pass@localhost:5432/dbname?sslmode=disable"

# [CRÍTICO] Clave AES-256 para cifrado de PII (emails).
# DEBE ser exactamente 32 caracteres (bytes).
# Generar con: openssl rand -base64 24 | cut -c1-32
# Rotar esta clave invalida todos los emails cifrados existentes.
EMAIL_ENCRYPTION_KEY="your-32-byte-aes-key-here!!"
